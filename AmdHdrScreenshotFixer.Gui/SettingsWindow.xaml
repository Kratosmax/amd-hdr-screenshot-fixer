<Window x:Class="AmdHdrScreenshotFixer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="设置" Icon="Assets/app-icon.ico" Width="820" Height="680" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <x:Array x:Key="PriorityValues" Type="{x:Type sys:Int32}">
            <sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32>
            <sys:Int32>6</sys:Int32><sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32><sys:Int32>10</sys:Int32>
        </x:Array>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="22,0" VerticalAlignment="Center">
                <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="系统、网络与更新" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,30,24">
                <TextBlock Text="系统" FontSize="16" FontWeight="SemiBold"/>
                <CheckBox x:Name="StartWithWindowsBox" Content="登录 Windows 后启动应用" Height="42" Margin="14,8,0,0" VerticalContentAlignment="Center"/>

                <Border Height="1" Margin="0,20" Background="{StaticResource BorderBrush}"/>
                <TextBlock Text="网络" FontSize="16" FontWeight="SemiBold"/>
                <Grid Margin="14,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="190"/><RowDefinition Height="40"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                    <TextBlock Text="GitHub 访问线路" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="36" Padding="0" Content="＋" ToolTip="添加 GitHub 前缀线路" Click="AddProxy_Click"/>
                        <Button Width="36" Padding="0" Margin="8,0,0,0" Content="−" ToolTip="删除所选线路" Click="RemoveProxy_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ProxyGrid" Grid.Row="1" Margin="0,8,0,0" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              RowHeaderWidth="0" RowHeight="36" ColumnHeaderHeight="36" HeadersVisibility="Column"
                              BorderBrush="{StaticResource BorderBrush}" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" SelectionUnit="FullRow" BeginningEdit="ProxyGrid_BeginningEdit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="地址" Width="*" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridComboBoxColumn Header="优先级" Width="96" ItemsSource="{StaticResource PriorityValues}"
                                                    SelectedItemBinding="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="优先级 10 到 1 依次尝试，0 表示禁用；直连项不可删除。"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="HTTP 网络代理" FontWeight="SemiBold"/><TextBlock Text="可选，不支持账号密码" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
                        <TextBox x:Name="HttpProxyBox" Grid.Column="1" Height="34" Padding="10,0" VerticalContentAlignment="Center" ToolTip="例如：http://127.0.0.1:7890"/>
                    </Grid>
                </Grid>

                <Border Height="1" Margin="0,20" Background="{StaticResource BorderBrush}"/>
                <TextBlock Text="更新" FontSize="16" FontWeight="SemiBold"/>
                <Grid Margin="14,10,0,0" MinHeight="74">
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="AutoUpdateBox" Content="启动后自动检查更新" Height="30" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="VersionText" Margin="24,0,110,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="UpdateStatusText" Margin="24,3,110,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="CheckUpdateButton" Content="检查更新" MinWidth="96" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CheckUpdate_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock x:Name="ErrorText" Foreground="#B93838" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,190,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" MinWidth="76" Margin="0,0,8,0" Click="Close_Click"/>
                    <Button Content="保存设置" MinWidth="96" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
