<Window x:Class="AmdHdrScreenshotFixer.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级校准" Icon="Assets/app-icon.ico" Width="1040" Height="720" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="22,0" VerticalAlignment="Center">
                <TextBlock Text="高级校准" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="至少三组内容一致、尺寸相同的异常图与参考图" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="对比图片" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="36" Padding="0" Content="＋" ToolTip="添加一组对比图" Click="AddPair_Click"/>
                        <Button Width="36" Padding="0" Margin="8,0,0,0" Content="−" ToolTip="移除所选组" Click="RemovePair_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="PairGrid" Grid.Row="1" Margin="0,8,0,12" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0" HeadersVisibility="Column"
                              RowHeight="38" ColumnHeaderHeight="36" BorderBrush="{StaticResource BorderBrush}"
                              GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="异常图" Width="*" Binding="{Binding AmdName}"/>
                            <DataGridTextColumn Header="参考图" Width="*" Binding="{Binding ReferenceName}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="每一组都会轮流作为验证集，评分不会使用正在拟合的图片。"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="综合评分" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ScoreText" Text="--" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="平均 ΔE2000" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MeanText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="P95 ΔE2000" FontSize="12" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="P95Text" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="校正结果" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="参考图" FontWeight="SemiBold"/>
                    <Border Grid.Row="1" Background="#16191E" CornerRadius="5" ClipToBounds="True"><Image x:Name="CorrectedPreview" Stretch="Uniform" Margin="8"/></Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="#16191E" CornerRadius="5" ClipToBounds="True"><Image x:Name="ReferencePreview" Stretch="Uniform" Margin="8"/></Border>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="ResultText" Text="添加三组以上对比图后开始校准" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="CalibrationProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="开始校准" MinWidth="100" IsEnabled="False" Click="StartCalibration_Click"/>
                    <Button Content="恢复内置模型" MinWidth="110" Margin="8,0,0,0" Click="RestoreFactory_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="关闭" MinWidth="76" Margin="0,0,8,0" Click="Close_Click"/>
                    <Button x:Name="ApplyButton" Content="应用校准" MinWidth="96" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
