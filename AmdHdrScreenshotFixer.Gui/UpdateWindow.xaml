<Window x:Class="AmdHdrScreenshotFixer.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMD HDR Screenshot Fixer 更新" Icon="Assets/app-icon.ico"
        Width="520" Height="420" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="发现新版本" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="更新内容" Margin="0,20,0,10" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource MutedBrush}"/>
        <Border Grid.Row="2" Background="{StaticResource BorderBrush}"/>
        <ScrollViewer Grid.Row="3" Margin="0,12,0,16" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" LineHeight="21"/>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed"
                         Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="SkipButton" Content="跳过此版本" MinWidth="96" Click="SkipButton_Click"/>
            <Button x:Name="LaterButton" Grid.Column="2" Content="稍后" MinWidth="76" Margin="0,0,8,0"
                    Click="LaterButton_Click"/>
            <Button x:Name="InstallButton" Grid.Column="3" Content="立即更新" MinWidth="102"
                    Style="{StaticResource PrimaryButton}" Click="InstallButton_Click"/>
        </Grid>
    </Grid>
</Window>
